rules_version = '2';

// ============================================================
// قواعد أمان Firestore لمتجر المشروبات
// ============================================================
// المبدأ: أي زبون يستطيع *قراءة* الأسعار، لكن *الكتابة* مقيّدة.
//
// كيف تستخدم هذا الملف؟
//   • الطريقة الأسهل: افتح Firebase Console → Firestore Database → Rules،
//     والصق محتوى هذا الملف ثم اضغط Publish.
//   • أو عبر Firebase CLI:  firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // مستند الأسعار الوحيد: store/prices
    match /store/prices {
      // القراءة متاحة للجميع (الزبائن يرون الأسعار)
      allow read: if true;

      // ----------------------------------------------------------------
      // الكتابة (تعديل الأدمن للأسعار).
      //
      // الوضع الحالي (للتجربة): مسموحة للجميع — بسيطة لكن غير آمنة للنشر.
      // قبل النشر الفعلي اختر إحدى الطريقتين الآمنتين أدناه:
      //
      //   (أ) الأبسط — أوقف الكتابة من التطبيق نهائياً، وعدّل الأسعار يدوياً
      //       من Firebase Console فقط:
      //          allow write: if false;
      //
      //   (ب) الأمتن — فعّل Firebase Authentication واسمح للأدمن فقط
      //       (استبدل ADMIN_UID بمعرّف حساب الأدمن):
      //          allow write: if request.auth != null
      //                       && request.auth.uid == "ADMIN_UID";
      // ----------------------------------------------------------------
      allow write: if true;
    }

    // أي مسار آخر: ممنوع افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
